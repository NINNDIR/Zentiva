rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function hasValidRole() {
      return role() in ['SUPER_USUARIO', 'TRABAJADORA_SOCIAL', 'DIRECTIVO'];
    }
    function isSuperUsuario() { return hasValidRole() && role() == 'SUPER_USUARIO'; }
    function isTrabajadoraSocial() {
      return hasValidRole() && role() in ['TRABAJADORA_SOCIAL', 'SUPER_USUARIO'];
    }
    function canReadSchoolData() { return hasValidRole(); }

    match /usuarios/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperUsuario());
      // The browser must never assign claims or change a role-bearing profile.
      allow write: if false;
    }

    match /alumnos/{matricula} {
      allow read: if canReadSchoolData();
      allow create, update, delete: if isTrabajadoraSocial();
      match /notas_confidenciales/{notaId} {
        allow read: if canReadSchoolData();
        allow create: if isTrabajadoraSocial();
        allow update, delete: if false;
      }
    }

    match /incidentes/{incidenteId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial();
      // Once closed, the ticket itself is immutable. Corrections belong in comments.
      allow update: if isTrabajadoraSocial() && resource.data.estatus != 'CERRADO';
      allow delete: if false;

      match /comentarios/{comentarioId} {
        allow read: if canReadSchoolData();
        allow create: if isTrabajadoraSocial();
        allow update, delete: if false;
      }
      match /auditoria_cambios/{logId} {
        allow read: if canReadSchoolData();
        allow create: if isTrabajadoraSocial();
        allow update, delete: if false;
      }
      // Legacy collection names remain read-only for existing data.
      match /anexos_comentarios/{comentarioId} {
        allow read: if canReadSchoolData();
        allow write: if false;
      }
      match /auditoria/{logId} {
        allow read: if canReadSchoolData();
        allow write: if false;
      }
    }

    match /retardos/{retardoId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial();
      allow update, delete: if false;
    }
    match /eventos_rapidos/{eventoId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial();
      allow update, delete: if false;
    }
    match /salidas_extraordinarias/{salidaId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial();
      allow update, delete: if false;
    }
    match /justificantes/{justificanteId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial();
      allow update, delete: if false;
    }
    match /canalizaciones/{canalizacionId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial();
      allow update: if isTrabajadoraSocial()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estatus', 'observaciones_seguimiento']);
      allow delete: if false;
    }

    match /cat_colonias/{coloniaId} {
      allow read: if canReadSchoolData();
      allow create: if isTrabajadoraSocial()
        && request.resource.data.pendiente_revision == true
        && request.resource.data.creada_por_usuario == true;
      allow update, delete: if isSuperUsuario();
    }
    match /cat_faltas/{faltaId} {
      allow read: if canReadSchoolData();
      allow write: if isSuperUsuario();
    }
    match /cat_instituciones_canalizacion/{instId} {
      allow read: if canReadSchoolData();
      allow write: if isSuperUsuario();
    }
  }
}
